# Copy to .env (next to compose.yaml) and fill in. docker compose reads it
# automatically and substitutes the values into compose.yaml; anything left
# out falls back to the defaults there. Values exported in the shell win over
# this file. compose.prod.yaml requires DJANGO_SECRET_KEY, POSTGRES_PASSWORD,
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY to be set.

# Deployment environment: LOCAL or PROD (defaults to LOCAL)
ENVIRONMENT=LOCAL

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed through CORS when ENVIRONMENT=PROD
DJANGO_CORS_ALLOWED_ORIGINS=
# Comma-separated origins the frontend is served from. Django rejects unsafe
# cross-origin requests whose Origin is not listed here, valid token or not.
# Defaults to the Vite dev server when ENVIRONMENT=LOCAL.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Postgres (also used by the postgres container to create the database)
POSTGRES_DB=saiddit
POSTGRES_USER=saiddit
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Redis (cache + sessions)
REDIS_URL=redis://redis:6379/0

# Garage (S3-compatible media storage)
# Key ID is "GK" + 24 hex chars, secret is 64 hex chars; import it into
# Garage with `garage key import`.
AWS_ACCESS_KEY_ID=GK000000000000000000000000
AWS_SECRET_ACCESS_KEY=change-me
AWS_STORAGE_BUCKET_NAME=saiddit
AWS_S3_REGION_NAME=garage
# Internal address the backend uses to reach the store: a compose service, a
# Kubernetes Service, or a real S3 endpoint. Never seen by a browser.
AWS_S3_ENDPOINT_URL=http://garage:3900
# Public base URL files are served from, with no signature attached, so it is
# independent of how the backend reaches the store. Locally this is garage's
# website endpoint (the bucket is exposed by garage-init); in a cluster, set it
# to the ingress or CDN in front of the bucket, e.g. files.example.com.
# Unset falls back to presigned URLs against AWS_S3_ENDPOINT_URL, which only
# resolve where that internal address does.
AWS_S3_CUSTOM_DOMAIN=saiddit.web.garage.localhost:3902
# 'http:' locally, 'https:' anywhere real.
AWS_S3_URL_PROTOCOL=http:
# path for Garage; virtual for AWS-style buckets.
AWS_S3_ADDRESSING_STYLE=path

# Layout the local Garage node is provisioned with by the garage-init service.
# It creates the bucket and imports the key above on every `docker compose up`.
GARAGE_ZONE=dc1
GARAGE_CAPACITY=1G
# Expose the bucket anonymously so AWS_S3_CUSTOM_DOMAIN URLs work.
GARAGE_BUCKET_PUBLIC=true

# Garage cluster. The RPC secret and admin token used to live in garage.toml;
# they are read from here so the committed config carries no secrets. Generate
# each with `openssl rand -hex 32`.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# Image tag for both the garage node and the garage-init CLI.
GARAGE_VERSION=v2.4.1
# Host ports the garage container is published on; the container-side ports
# are fixed by the bind addresses in garage.toml.
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
